# ============================================================
# AI RAKSASA — Environment Variables
# Salin file ini ke .env.local dan isi semua key
# ============================================================

# --- 10 API PROVIDERS ---

# Groq Cloud (Inference Cepat)
GROQ_API_KEY=

# Google Gemini (Multimodal, Vision, Long Context)
GEMINI_API_KEY=

# DeepSeek (Reasoning & Logic)
DEEPSEEK_API_KEY=

# Mistral AI (Code Quality)
MISTRAL_API_KEY=

# Cerebras (Ultra-fast Inference)
CEREBRAS_API_KEY=

# Together AI (Open-source Model Hosting)
TOGETHER_API_KEY=

# Fireworks AI (Specialized Models)
FIREWORKS_API_KEY=

# Tavily (AI Search Engine)
TAVILY_API_KEY=

# NVIDIA NIM (Enterprise GPU Inference)
NVIDIA_API_KEY=

# Cloudflare Workers AI (Edge Inference)
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# --- FIREBASE (Memory & Auth) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- CANVA (Design Integration) ---
CANVA_PUBLIC_KEY=
CANVA_KID=

# --- APP CONFIG ---
APP_ENV=development
MAX_CHUNK_SIZE=500
OVERLAP_SIZE=30
MAX_OUTPUT_TOKENS_FAST=4096
MAX_OUTPUT_TOKENS_REVIEW=4096
MAX_OUTPUT_TOKENS_FINAL=8192
MAX_RETRIES=3
RETRY_DELAY_MS=2000
